[Unit]
Description=Hourly cord set catalog sync (stock/price/compat for the cord set builder)
Documentation=https://github.com/sundialwire/greenlight
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=welch
WorkingDirectory=/home/welch/projects/sundial_greenlight
Environment="PATH=/home/welch/projects/sundial_greenlight/venv/bin:/usr/local/bin:/usr/bin:/bin"
# Live-fetch Wire products -> cordsets.catalog.json, then publish a copy to
# /var/www/cordset/, served by nginx at
# https://greenlight.sundialwire.com/cordset/cordsets.catalog.json. The storefront
# builder loads that, so stock/price changes need no app deploy. (The copy
# bundled with the app is the fallback; refresh it with build_extension.py
# when deploying.)
ExecStart=/home/welch/projects/sundial_greenlight/venv/bin/python util/wire/cordset/sync_catalog.py

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cordset-catalog-sync
